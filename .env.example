# ==========================================
# 1. Stack Configuration (Docker Compose & Hermes)
# ==========================================
# Path to your personal files/knowledge base (mounted into containers).
# Docker Compose requires an absolute path (or $HOME/Personal).
STACK_ROOT=/Users/rishabh.umrao/Personal

# Container UID/GID (defaults to 1000 if unset)
UID=1000
GID=1000

# Hermes Dashboard Authentication
HERMES_DASHBOARD_BASIC_AUTH_USERNAME=admin
# Set explicitly for Docker Compose, or leave blank for Ansible to auto-generate:
HERMES_DASHBOARD_BASIC_AUTH_PASSWORD=""

# Hermes Secrets (set for Docker Compose, or leave blank for Ansible to auto-generate):
# Generate with: openssl rand -hex 32
API_SERVER_KEY=""
HERMES_DASHBOARD_BASIC_AUTH_SECRET=""

# LLM Providers
LLAMACPP_BASE_URL="http://localhost:8080/v1"
LLAMACPP_MODEL_NAME="nemotron-3-nano-omni-30b-a3b-reasoning-q4-k-m"

# Fallback provider API keys (leave blank to skip)
OPENROUTER_API_KEY=""
KILO_GATEWAY_API_KEY=""
MISTRAL_API_KEY=""

# CodeGraph (internal code intelligence)
CODEGRAPH_ENABLED=true

# fs-notifier debounce interval in seconds (how long to wait after last file change)
FS_NOTIFIER_DEBOUNCE_SECONDS=30

# ==========================================
# 2. Host & Deployment Options (Ansible / Syncthing)
# ==========================================
TARGET_HOST="rpi.burro-smelt.ts.net"
TARGET_USER="pi"

# Tailscale Auth (optional, needed only when provisioning a device NOT yet on your tailnet)
TAILSCALE_AUTH_KEY=""

# Syncthing GUI Auth (leave password blank for Ansible to auto-generate)
SYNCTHING_GUI_USER="admin"
SYNCTHING_GUI_PASSWORD=""

# Git repository to deploy
PAI_REPO_URL="https://github.com/ayedaemon/pai-stack.git"

# SSH / Sudo Credentials (optional, for zero-prompt Ansible deploys)
SSH_PASSWORD=""
BECOME_PASSWORD=""
