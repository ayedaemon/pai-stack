# ==========================================
# 1. Target Server
# ==========================================
TARGET_HOST="rpi.burro-smelt.ts.net"
TARGET_USER="pi"

# ==========================================
# 2. Tailscale Auth (optional)
# ==========================================
# Needed only when provisioning a device NOT yet on your tailnet.
# Leave blank if the target already has Tailscale up.
TAILSCALE_AUTH_KEY=""

# ==========================================
# 3. Stack Configuration
# ==========================================
# LLM Provider
LLAMACPP_BASE_URL="http://localhost:8080/v1"
LLAMACPP_MODEL_NAME="nemotron-3-nano-omni-30b-a3b-reasoning-q4-k-m"

# Fallback provider API keys (leave blank to skip)
OPENROUTER_API_KEY=""
KILO_GATEWAY_API_KEY=""
MISTRAL_API_KEY=""

# Hermes Dashboard auth (blank = auto-generate on first deploy)
HERMES_DASHBOARD_PASSWORD=""

# CodeGraph (set to false to disable)
CODEGRAPH_ENABLED=true

# ==========================================
# 4. Data Location
# ==========================================
# Path ON THE TARGET for notes (default ~/Personal)
STACK_ROOT=~/Personal

# ==========================================
# 5. fs-notifier (watches STACK_ROOT, notifies downstream services)
# ==========================================
# Debounce interval in seconds — how long to wait after last file change
# before triggering a CodeGraph rebuild. Higher = fewer rebuilds.
FS_NOTIFIER_DEBOUNCE_SECONDS=30

# ==========================================
# 6. Git repo to deploy
# ==========================================
PAI_REPO_URL="https://github.com/ayedaemon/pai-stack.git"

# ==========================================
# 7. SSH / Sudo Credentials (optional)
# ==========================================
# Set for zero-prompt deploys. Leave blank to be prompted.
SSH_PASSWORD=""
BECOME_PASSWORD=""
