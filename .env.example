# pai-stack environment configuration
# ==========================================================
# 4 services: hermes, codegraph, embeddings, and mcp-server

# ── 1. HOST WORKSPACE DIRECTORY — REQUIRED ────────────────
# Path on host to the directory containing your codebases and knowledge base.
# Can be a relative path (e.g. ./workspace) or an absolute path.
# IMPORTANT: This directory MUST already exist on your host machine before starting!
# Mounted read-write at /workspace in hermes (Hermes can edit project files).
# Mounted read-only at /workspace in codegraph (for indexing).
WORKSPACE_DIR=./workspace

# ── 2. LLM CONFIGURATION ──────────────────────────────────
# Primary: local or remote llama.cpp / Ollama / vLLM (OpenAI-compatible)
# • For local LLM running on host machine: "http://host.docker.internal:8080/v1"
# • For remote / Tailscale LLM node: "http://100.x.y.z:8080/v1" or "http://my-gpu-node:8080/v1"
LLAMACPP_BASE_URL="http://host.docker.internal:8080/v1"
LLAMACPP_MODEL_NAME="nemotron-3-nano-omni-30b-a3b-reasoning-q4-k-m"

# Required when config.yaml uses key_env: OPENAI_API_KEY for a custom provider.
# llama.cpp / Ollama ignore the value; set any non-empty string to activate the provider.
OPENAI_API_KEY="not-needed"

# Fallback cloud keys (optional — leave blank to skip)
OPENROUTER_API_KEY=""
KILO_GATEWAY_API_KEY=""
MISTRAL_API_KEY=""

# ── 3. HERMES DASHBOARD & API SECRETS ─────────────────────
# How to choose / generate each secret:
#
# • HERMES_DASHBOARD_BASIC_AUTH_USERNAME:
#   Username for HTTP Basic Auth to Hermes Dashboard (:9119 / :8642).
#   Char limits: Typically 3-32 alphanumeric characters (default: admin).
#
# • HERMES_DASHBOARD_BASIC_AUTH_PASSWORD:
#   Password for Dashboard login (hashed via scrypt inside container).
#   Char limits: Recommended min 8-12+ characters for security.
#   Generate: openssl rand -hex 12
#
# • HERMES_DASHBOARD_BASIC_AUTH_SECRET:
#   Cryptographic secret used for dashboard session cookie encryption & signing.
#   Char limits: Minimum 32 characters; 64 hex characters (32 bytes) strongly recommended.
#   Generate: openssl rand -hex 32
#
# • API_SERVER_KEY:
#   Bearer token for authenticating REST API requests to Hermes gateway server.
#   Char limits: Minimum 32 characters; 64 hex characters (32 bytes) recommended.
#   Generate: openssl rand -hex 32
HERMES_DASHBOARD_BASIC_AUTH_USERNAME=admin
HERMES_DASHBOARD_BASIC_AUTH_PASSWORD="changeme-dashboard-password"
HERMES_DASHBOARD_BASIC_AUTH_SECRET="changeme-auth-secret-32-chars-min"
API_SERVER_KEY="changeme-api-server-key-32-chars"

# ── 4. RUNTIME SETTINGS ───────────────────────────────────
# KB_DIRS: unused — Hermes knowledgebase is disabled. CodeGraph handles all retrieval.
# (kept for backward compatibility, has no effect)
KB_DIRS="."
FS_NOTIFIER_DEBOUNCE_SECONDS=30

# Subdirectory inside WORKSPACE_DIR for CodeGraph to index (e.g. "Projects" or "my-app").
# Leave empty or set to "." to index the entire workspace.

# Mnemosyne Memory:
# Hermes uses Mnemosyne as its default local-first agent memory layer.
# Memory SQLite DBs are automatically persisted inside the hermes-data Docker volume.
# Optional overrides (defaults set in docker-compose.yaml):
# MNEMOSYNE_AUTO_SLEEP_ENABLED=true
# MNEMOSYNE_AUTO_SLEEP_THRESHOLD=30

# Dedicated lightweight embedding model for CodeGraph & Hermes semantic retrieval
# (Default: nomic-ai/nomic-embed-text-v1.5)
EMBEDDING_MODEL="nomic-ai/nomic-embed-text-v1.5"

# Container file ownership:
# Matches your host user so containers write files with proper ownership (avoiding EACCES).
# To find your active host IDs, run in your terminal:
#   UID: id -u
#   GID: id -g
UID=1000
GID=1000

# ── 5. OPEN NOTEBOOK (optional — only for make up-all) ────────────────────
# Open Notebook is an opt-in research knowledge base (Notebook LM alternative).
# None of these vars are needed for the base stack (make up). They are only
# read when docker-compose.open-notebook.yml overlay is active.
#
# • OPEN_NOTEBOOK_ENCRYPTION_KEY:
#   Encrypts API provider keys stored in SurrealDB. Required before first run.
#   Once set, do NOT change it (encrypted data becomes unreadable).
#   Generate: openssl rand -hex 32
#
# • OPEN_NOTEBOOK_PASSWORD:
#   Optional password for the Open Notebook web UI and REST API.
#   If unset, the web UI is open — suitable for local-only use.
#
# • SURREAL_USER / SURREAL_PASSWORD:
#   SurrealDB credentials. Used only by open-notebook and surrealdb containers.
#   These are INTERNAL credentials (container-to-container) — surrealdb does not
#   expose a host port in this stack, so changing these is optional.
#
# • OPEN_NOTEBOOK_LLM_BASE_URL / OPEN_NOTEBOOK_LLM_MODEL:
#   Override if you want Open Notebook to use a different LLM than Hermes.
#   By default, Open Notebook reuses LLAMACPP_BASE_URL and LLAMACPP_MODEL_NAME.
OPEN_NOTEBOOK_ENCRYPTION_KEY="CHANGE-ME-before-first-run"
OPEN_NOTEBOOK_PASSWORD=""
SURREAL_USER="root"
SURREAL_PASSWORD="root"
OPEN_NOTEBOOK_LLM_BASE_URL=""
OPEN_NOTEBOOK_LLM_MODEL=""
