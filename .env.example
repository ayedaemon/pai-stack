# Hermes Agent Environment Variables
# Copy to .env and fill in values: cp .env.example .env

# Container user mapping (match host user for correct file ownership)
# Run `id -u` and `id -g` on the host to get your values
UID=1000
GID=1000

# Dummy key — omniroute handles real auth
OPENAI_API_KEY=249a9de3fcddd4e182c58f4b487d1815a42d4cfadfaec86397ac986300df9f15

# API key for the Hermes OpenAI-compatible server (generate with: openssl rand -hex 32)
API_SERVER_KEY=

# Dashboard authentication (generate secrets with: openssl rand -hex 32)
HERMES_DASHBOARD_BASIC_AUTH_USERNAME=admin
HERMES_DASHBOARD_BASIC_AUTH_PASSWORD=
HERMES_DASHBOARD_BASIC_AUTH_SECRET=

# SilverBullet authentication
SB_USER=admin
SB_PASSWORD=admin
