# pai-stack — single .env for BOTH modes
# ==========================================================
# MODE is explicit: ./deploy.sh --local (default) OR ./deploy.sh --remote
#   --local  = docker compose only (ignores TARGET_HOST/TAILSCALE/SYNCTHING)
#   --remote = ansible to Pi (also does tailscale+syncthing+compose)
# Copy: cp .env.example .env, then edit the few lines you need.
# Most users only touch Sections 1-3. Rest has sane defaults or auto-generates.
# ==========================================================

# ── 1. WORKSPACE — REQUIRED (both modes) ─────────────────
# Absolute path to your stack_root (KB markdown + codebases).
# - Local: mounted as /stack_root inside containers
# - Remote: this Mac folder synced to Pi ~/stack_root via Syncthing
# No default — deploy.sh fails fast if empty. Example: $HOME/stack_root
STACK_ROOT=/Users/rishabh.umrao/stack_root

# ── 2. LLM — make Hermes answer (both modes) ─────────────
# Primary: local llama.cpp / Ollama (OpenAI-compatible)
LLAMACPP_BASE_URL="http://localhost:8080/v1"
LLAMACPP_MODEL_NAME="nemotron-3-nano-omni-30b-a3b-reasoning-q4-k-m"
# Fallback cloud keys — set at least one so Hermes works when local LLM is down.
# Leave blank to skip a provider. Get keys from openrouter.ai / api.mistral.ai / kilo.ai
OPENROUTER_API_KEY=""
KILO_GATEWAY_API_KEY=""
MISTRAL_API_KEY=""

# ── 3. DEPLOY TARGET — where to run (both modes) ─────────
# Empty = local (Mac/Linux Docker). Set = remote Pi via SSH.
# Examples: "" (local), "rpi.burro-smelt.ts.net" (Tailscale), "192.168.1.50" (LAN)
TARGET_HOST=""
TARGET_USER="pi"                      # SSH user on Pi (ignored in --local)

# ── 4. SECRETS — auto-generated if blank (both modes) ────
# Leave blank on first run; deploy.sh generates with `openssl rand` and writes back to .env.
# To set manually: openssl rand -hex 32 (API/secret) or -hex 12 (passwords)
HERMES_DASHBOARD_BASIC_AUTH_USERNAME=admin
HERMES_DASHBOARD_BASIC_AUTH_PASSWORD=""
HERMES_DASHBOARD_BASIC_AUTH_SECRET=""
API_SERVER_KEY=""

# ── 5. SERVICES — sane defaults, rarely change (both modes)
CODEGRAPH_ENABLED=true                 # code search on/off
# KB dirs to index, comma-separated, relative to STACK_ROOT. "." = everything.
# Tip: "Projects,References" to index less on small Pi.
KB_DIRS="."
FS_NOTIFIER_DEBOUNCE_SECONDS=30        # seconds to wait after file change before reindex

# ── 6. ADVANCED — remote-only & rarely touched ───────────
# Tailscale: only for fresh Pi not yet on your tailnet (leave blank if Pi already joined)
TAILSCALE_AUTH_KEY=""

# Syncthing GUI (remote only, blank → auto-generated on Pi, ignored in --local)
SYNCTHING_GUI_USER="admin"
SYNCTHING_GUI_PASSWORD=""

# Container file ownership — matches Pi/Mac user (id -u / id -g). Most leave at 1000.
# deploy.sh and Ansible detect real UID/GID; these are fallbacks for `docker compose` local.
UID=1000
GID=1000

# Power users only:
PAI_REPO_URL="https://github.com/ayedaemon/pai-stack.git"  # fork if you customize
SSH_PASSWORD=""                        # for zero-prompt ansible (gitignored, never copied to Pi)
BECOME_PASSWORD=""                     # sudo password for Pi (also gitignored)
