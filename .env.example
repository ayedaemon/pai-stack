# ==========================================
# 1. Target Server
# ==========================================
# The IP or hostname Ansible will SSH to. This can be EITHER:
#   - a LAN address        (e.g. 192.168.1.50) while the Pi is on your local network, OR
#   - a Tailscale address   (MagicDNS name e.g. rpi.burro-smelt.ts.net, or 100.x.y.z)
# Ansible installs Docker + Tailscale there from bare SSH.
TARGET_HOST="rpi.burro-smelt.ts.net"
TARGET_USER="pi"

# ==========================================
# 2. Stack Configuration
# ==========================================
# Public hostname Caddy serves TLS for (usually the Tailscale MagicDNS name).
TAILSCALE_DOMAIN="rpi.burro-smelt.ts.net"

# ── LLM Provider ────────────────────────────────────────────────────────
# Primary model server (llama.cpp, Ollama, or any OpenAI-compatible endpoint)
LLAMACPP_BASE_URL="http://localhost:8080/v1"
LLAMACPP_MODEL_NAME="nemotron-3-nano-omni-30b-a3b-reasoning-q4-k-m"

# Provider API keys for Hermes fallback providers.
# Get your keys from each provider's dashboard. Set empty to skip that provider.
OPENROUTER_API_KEY=""
KILO_GATEWAY_API_KEY=""
MISTRAL_API_KEY=""

# Hermes Dashboard — leave blank to auto-generate a random
# password on first deploy (saved to the target .env, printed at end of deploy).
# Set explicitly here if you want a known password instead.
HERMES_DASHBOARD_PASSWORD=""

# Syncthing GUI basic-auth (served through Caddy). Leave PASSWORD blank to
# auto-generate a random one (saved to the target .env on first deploy).
SYNCTHING_GUI_USER="admin"
SYNCTHING_GUI_PASSWORD=""

# CodeGraph — code intelligence for Hermes (set to false to disable)
CODEGRAPH_ENABLED=true

# ==========================================
# 3. Tailscale Auth (for fresh devices)
# ==========================================
# Needed only when provisioning a device that is NOT yet on your tailnet.
# Generate at https://login.tailscale.com/admin/settings/keys
# Leave blank if the target already has Tailscale up (e.g. you're SSHing to it
# via its Tailscale IP) — Ansible will then just set the operator and skip install.
TAILSCALE_AUTH_KEY=""

# ==========================================
# 4. Data Location
# ==========================================
# Where Hermes / Syncthing store your notes & knowledge base.
# This is a path ON THE TARGET PI (not your dev machine). It defaults to the
# target user's ~/Personal (e.g. /home/pi/Personal). Do NOT use ${HOME} here —
# that expands to your dev machine's home and would be written to the Pi.
PERSONAL_FOLDER=~/Personal

# ==========================================
# 5. SSH / Sudo Credentials (optional, for unattended runs)
# ==========================================
# Set these to let ./deploy.sh run with ZERO prompts.
#   SSH_PASSWORD     = SSH login password on the target (remote runs only)
#   BECOME_PASSWORD  = sudo password on the target — set for ZERO prompts
# Leave blank to be prompted interactively.
# Stored ONLY in this local .env (gitignored) — never copied to the target.
SSH_PASSWORD=""
BECOME_PASSWORD=""
