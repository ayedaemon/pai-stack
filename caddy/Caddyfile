# Caddy reverse proxy with Tailscale TLS
# External access via Tailscale HTTPS, internal communication over local Docker network.

# Hermes — Dashboard
{$TAILSCALE_DOMAIN:rpi.burro-smelt.ts.net}:9119 {
	tls {
		get_certificate tailscale
	}
	reverse_proxy hermes:9119
}

# Hermes — API Server
{$TAILSCALE_DOMAIN:rpi.burro-smelt.ts.net}:8642 {
	tls {
