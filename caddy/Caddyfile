# Caddy reverse proxy with Tailscale TLS
# External access via Tailscale HTTPS, internal communication over local Docker network.

# OmniRoute — AI model routing gateway
{$TAILSCALE_DOMAIN:rpi.burro-smelt.ts.net}:20128 {
	tls {
		get_certificate tailscale
	}
	reverse_proxy omniroute:20128
}

