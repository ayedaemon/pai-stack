# Caddy reverse proxy with Tailscale TLS
# All services are accessed via rpi.burro-smelt.ts.net on their respective ports

# OmniRoute — AI model routing gateway
rpi.burro-smelt.ts.net:20128 {
	tls {
		get_certificate tailscale
	}
	reverse_proxy omniroute:20128
}

# Hermes — Dashboard
rpi.burro-smelt.ts.net:9119 {
	tls {
		get_certificate tailscale
	}
	reverse_proxy hermes:9119
}

# Hermes — API Server
rpi.burro-smelt.ts.net:8642 {
	tls {
		get_certificate tailscale
	}
	reverse_proxy hermes:8642
}

# SilverBullet — Knowledge base
rpi.burro-smelt.ts.net:7070 {
	tls {
		get_certificate tailscale
	}
	reverse_proxy silverbullet:3000
}
