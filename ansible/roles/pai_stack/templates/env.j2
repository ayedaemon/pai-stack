# Auto-generated by Ansible for pai-stack
UID={{ target_uid | default(pai_uid) }}
GID={{ target_gid | default(pai_gid) }}

# Tailscale Domain for Caddy HTTPS reverse proxy
TAILSCALE_DOMAIN={{ tailscale_domain }}

# Where notes & knowledge base live (mounted into Hermes/SilverBullet/Syncthing)
STACK_ROOT={{ pai_personal_dir }}

# OmniRoute Dummy Key (OmniRoute ignores the client key; a non-empty value is
# required so Hermes' openai-api provider initializes and enumerates models)
OPENAI_API_KEY={{ openai_api_key | default('not-needed') }}

# Hermes OpenAI-compatible API Server Key
API_SERVER_KEY={{ generated_api_server_key }}

# Hermes Dashboard Basic Auth
HERMES_DASHBOARD_BASIC_AUTH_USERNAME={{ hermes_dashboard_username }}
HERMES_DASHBOARD_BASIC_AUTH_PASSWORD={{ generated_hermes_dashboard_password }}
HERMES_DASHBOARD_BASIC_AUTH_SECRET={{ generated_hermes_dashboard_secret }}

# SilverBullet Authentication
SB_USER={{ sb_user }}
SB_PASSWORD={{ generated_sb_password }}

# Syncthing GUI Basic Auth (served via Caddy)
SYNCTHING_GUI_USER={{ generated_syncthing_gui_user }}
SYNCTHING_GUI_PASSWORD={{ generated_syncthing_gui_password }}

# Delegate agents (Antigravity CLI + OpenCode CLI) — driven by Hermes over MCP
ANTIGRAVITY_MODEL={{ antigravity_model | default('Gemini 3.5 Flash (High)') }}
OPENCODE_MODEL={{ opencode_model | default('') }}
OPENCODE_PERMISSION={{ opencode_permission | default('{"*":"allow"}') }}
