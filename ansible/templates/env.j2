# Auto-generated by Ansible — overwritten on every deploy
# Edit ansible/group_vars/all.yml or pass extra vars to customize.

# Container UID/GID (matches host user)
UID={{ target_uid | default(pai_uid | default(1000)) }}
GID={{ target_gid | default(pai_gid | default(1000)) }}

# Data location (bind-mounted by containers)
STACK_ROOT={{ pai_personal_dir }}

# LLM Provider
LLAMACPP_BASE_URL={{ llamacpp_base_url }}
LLAMACPP_MODEL_NAME={{ llamacpp_model_name }}

# Fallback provider API keys
OPENROUTER_API_KEY={{ openrouter_api_key | default('') }}
KILO_GATEWAY_API_KEY={{ kilo_gateway_api_key | default('') }}
MISTRAL_API_KEY={{ mistral_api_key | default('') }}

# Hermes secrets
API_SERVER_KEY={{ generated_api_key }}
HERMES_DASHBOARD_BASIC_AUTH_USERNAME={{ hermes_dashboard_username | default('admin') }}
HERMES_DASHBOARD_BASIC_AUTH_PASSWORD={{ generated_dash_pass }}
HERMES_DASHBOARD_BASIC_AUTH_SECRET={{ generated_dash_secret }}

# CodeGraph
CODEGRAPH_ENABLED={{ codegraph_enabled | default('true') }}

# fs-notifier
FS_NOTIFIER_DEBOUNCE_SECONDS={{ fs_notifier_debounce_seconds | default(30) }}
