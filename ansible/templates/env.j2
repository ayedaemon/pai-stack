# Auto-generated by Ansible — overwritten on every deploy
# Edit ansible/group_vars/all.yml or pass extra vars to customize.

# Container UID/GID (matches host user)
UID={{ target_uid | default(pai_uid | default(1000)) }}
GID={{ target_gid | default(pai_gid | default(1000)) }}

# Data location (bind-mounted by containers)
STACK_ROOT={{ pai_stack_root }}

# LLM Provider
LLAMACPP_BASE_URL={{ LLAMACPP_BASE_URL | default(llamacpp_base_url) }}
LLAMACPP_MODEL_NAME={{ LLAMACPP_MODEL_NAME | default(llamacpp_model_name) }}

# Fallback provider API keys
OPENROUTER_API_KEY={{ OPENROUTER_API_KEY | default(openrouter_api_key | default('')) }}
KILO_GATEWAY_API_KEY={{ KILO_GATEWAY_API_KEY | default(kilo_gateway_api_key | default('')) }}
MISTRAL_API_KEY={{ MISTRAL_API_KEY | default(mistral_api_key | default('')) }}

# Hermes secrets
API_SERVER_KEY={{ generated_api_key }}
HERMES_DASHBOARD_BASIC_AUTH_USERNAME={{ HERMES_DASHBOARD_BASIC_AUTH_USERNAME | default(hermes_dashboard_username | default('admin')) }}
HERMES_DASHBOARD_BASIC_AUTH_PASSWORD={{ generated_dash_pass }}
HERMES_DASHBOARD_BASIC_AUTH_SECRET={{ generated_dash_secret }}

# CodeGraph
CODEGRAPH_ENABLED={{ CODEGRAPH_ENABLED | default(codegraph_enabled | default('true')) }}

# fs-notifier
FS_NOTIFIER_DEBOUNCE_SECONDS={{ FS_NOTIFIER_DEBOUNCE_SECONDS | default(fs_notifier_debounce_seconds | default(30)) }}

# KB directories (comma-separated, relative to STACK_ROOT)
KB_DIRS={{ KB_DIRS | default(kb_dirs | default('.')) }}
